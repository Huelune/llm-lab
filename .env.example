# 회사 LLM 접속 정보. 이 파일을 .env로 복사한 뒤 값을 채우세요 (.env는 커밋되지 않음).
# /v1까지만 적습니다. …/v1/chat/completions처럼 전체 주소를 넣어도 뒤쪽은 자동으로 잘라냅니다.
# LLM_CLIENT=azure면 회사 샘플 코드의 base_url 값을 그대로 적습니다 (/openai/… 는 SDK가 붙임)
LLM_BASE_URL=https://llm.example.internal/v1
# 키 없이 쓰는 서버면 비워 둡니다 (Authorization 헤더를 보내지 않음)
LLM_API_KEY=
# 키와 별도로 프로젝트 ID를 요구하는 게이트웨이면 채웁니다. 비워 두면 프로젝트 헤더를 보내지 않음
LLM_PROJECT_ID=
# 프로젝트 ID를 담을 헤더 이름. 게이트웨이 안내문에 적힌 이름을 그대로 적습니다. 비워 두면 OpenAI-Project
LLM_PROJECT_HEADER=
# 접속 방식. 회사 샘플 코드가 AzureOpenAI를 쓰면 azure (키를 api-key 헤더로 보내고 경로에
# /openai/deployments/<모델>/ 을 붙임). 비워 두면 openai (Bearer 키, LLM_BASE_URL/chat/completions)
LLM_CLIENT=
# azure 방식의 api-version 쿼리. 샘플처럼 비워 두면 붙이지 않음
LLM_API_VERSION=
LLM_MODEL=
# 요청 타임아웃(초). 비워 두면 60
LLM_TIMEOUT=
# llm-fix-server가 LLM에 동시에 보내는 요청 수(1~16). 비워 두면 2.
# 게이트웨이가 몇 개까지 받는지는 uv run llm-probe --parallel 4 처럼 재 봅니다
LLM_WORKERS=
# 자체 서명 인증서 서버라 인증서 검증이 실패하면 false (requests의 verify=False와 같음). 비워 두면 true
LLM_VERIFY_SSL=
# 생각 모드를 지원하는 모델에서 끄려면 false (chat_template_kwargs.enable_thinking). 비워 두면 보내지 않음
LLM_ENABLE_THINKING=
